# Supabase. Sem estas variáveis o site funciona em modo local: os dados ficam
# guardados apenas no navegador do dispositivo. Ver README.md.
# Supabase → Settings → API Keys:
# - Project URL       → SUPABASE_URL
# - Secret key        → SUPABASE_SECRET_KEY (nunca a coloques no browser)
#
# Copia estes nomes para .env.local (fora do Git) ou para as variáveis da Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# PINs de acesso ao site, separados por vírgulas (ex.: APP_PINS=1234,5678).
# Sem esta variável o site fica fechado em produção.
APP_PINS=

# Compatibilidade: também é aceite o nome antigo da chave de serviço.
# SUPABASE_SERVICE_ROLE_KEY=
